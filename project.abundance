        {
          "atomType": "Code",
          "x": 0.5,
          "y": 0.5,
          "uniqueID": "id-490",
          "ioValues": [
            {
              "name": "hub",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "strutProfile",
              "ioValue": "__GEOMETRY_INPUT__"
            },
            {
              "name": "domeDiameter",
              "ioValue": 6000
            },
            {
              "name": "frequency",
              "ioValue": 3
